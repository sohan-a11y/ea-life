FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin life && mkdir -p /app /state /exchange/requests /exchange/results /control && chown -R 10001:10001 /app /state /exchange /control
WORKDIR /app
COPY --chown=10001:10001 ea_life /app/ea_life
COPY --chown=10001:10001 runner.py /app/runner.py
USER 10001:10001
CMD ["python", "-u", "runner.py"]
