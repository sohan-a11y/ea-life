FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin life && mkdir -p /app /exchange/requests /exchange/results /state /control && chown -R 10001:10001 /app /exchange /state /control
WORKDIR /app
COPY --chown=10001:10001 life.py /app/life.py
USER 10001:10001
CMD ["python","-u","/app/life.py"]
