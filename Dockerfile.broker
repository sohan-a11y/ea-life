FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin broker && mkdir -p /app /exchange/requests /exchange/results && chown -R 10001:10001 /app /exchange
WORKDIR /app
COPY --chown=10001:10001 broker.py /app/broker.py
USER 10001:10001
CMD ["python","-u","/app/broker.py"]
