FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin dashboard && mkdir -p /app /control /state && chown -R 10001:10001 /app /control /state
WORKDIR /app
COPY --chown=10001:10001 dashboard.py /app/dashboard.py
COPY --chown=10001:10001 web /app/web
USER 10001:10001
EXPOSE 8000
CMD ["python","-u","/app/dashboard.py"]
